
# MERCADO AUTO backend configuration
NODE_ENV=development
PORT=3000

# Generate a long, random secret for your API
ADMIN_API_KEY=replace_with_a_long_random_secret

# PostgreSQL database connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSL=false

# CJ Dropshipping API
CJ_ACCESS_TOKEN=replace_with_your_cj_access_token

# CamerPay API
CAMERPAY_API_BASE_URL=https://replace-with-your-confirmed-api-host
CAMERPAY_API_TOKEN=replace_with_your_camerpay_api_token

# Telegram bot (for later integration)
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_webhook_secret
