
# Environnement
NODE_ENV=development
PORT=3000

# Sécurité de l'API MERCADO AUTO
ADMIN_API_KEY=replace_with_a_long_random_secret

# Base de données PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSL=false

# CJ Dropshipping
CJ_ACCESS_TOKEN=replace_with_your_cj_access_token

# CamerPay
CAMERPAY_API_BASE_URL=https://replace-with-your-confirmed-api-host
CAMERPAY_API_TOKEN=replace_with_your_camerpay_api_token
